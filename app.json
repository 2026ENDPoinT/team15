{
  "expo": {
    "name": "GongMoa",
    "slug": "team15-campus-notice",
    "version": "0.1.0",
    "scheme": "campusnotice",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F8F7",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
