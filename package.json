{
  "name": "team15-campus-notice",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:web": "expo export --platform web --output-dir dist/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "format": "prettier --write app src shared fixtures tests scripts package.json app.json playwright.config.ts tsconfig.json README.md docs/campus_notice_c_startup_plan.md docs/campus_notice_t01_handoff.md docs/campus_notice_t02_handoff.md worker docs/campus_notice_t05_handoff.md docs/campus_notice_t07_handoff.md docs/campus_notice_t09_handoff.md",
    "format:check": "prettier --check app src shared fixtures tests scripts package.json app.json playwright.config.ts tsconfig.json README.md docs/campus_notice_c_startup_plan.md docs/campus_notice_t01_handoff.md docs/campus_notice_t02_handoff.md worker docs/campus_notice_t05_handoff.md docs/campus_notice_t07_handoff.md docs/campus_notice_t09_handoff.md",
    "check": "npm run typecheck && npm test && npm run format:check",
    "test:e2e": "EXPO_PUBLIC_ENABLE_DEV_TOOLS=1 npm run build:web && EXPO_PUBLIC_ENABLE_DEV_TOOLS=1 playwright test",
    "test:e2e:release": "EXPO_PUBLIC_ENABLE_DEV_TOOLS=0 npm run build:web && EXPO_PUBLIC_ENABLE_DEV_TOOLS=0 playwright test tests/e2e/developer_tools.spec.ts",
    "collect:smoke": "node --import tsx scripts/collect_smoke.ts",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:build": "wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir ../dist/worker",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:login": "wrangler login --scopes account:read user:read workers:write workers_scripts:write",
    "worker:setup": "node --import tsx scripts/worker_setup.ts",
    "worker:models": "node --import tsx scripts/worker_models.ts",
    "worker:smoke": "node --import tsx scripts/worker_smoke.ts",
    "test:worker": "node --import tsx --test --experimental-test-isolation=none tests/worker*.test.ts",
    "worker:secrets": "node --import tsx scripts/worker_secrets.ts",
    "worker:access-smoke": "node --import tsx scripts/worker_access_smoke.ts",
    "worker:expiry-smoke": "node --import tsx scripts/worker_expiry_smoke.ts",
    "sync:smoke": "node --import tsx scripts/t07_smoke.ts",
    "test:t09": "node --import tsx --test --experimental-test-isolation=none tests/t09Integration.test.ts tests/eligibility.test.ts",
    "t09:candidates": "node --import tsx scripts/t09_candidates.ts",
    "t09:live-smoke": "node --import tsx scripts/t09_live_smoke.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "15.1.1",
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "esbuild": "^0.28.2",
    "expo": "58.0.25",
    "expo-constants": "58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "58.0.5",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "miniflare": "5.20261110.2-beta",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.161.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
