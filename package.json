{
  "name": "team15-campus-notice",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:web": "expo export --platform web --output-dir dist/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "format": "prettier --write app src shared fixtures tests package.json app.json playwright.config.ts tsconfig.json README.md docs/campus_notice_c_startup_plan.md docs/campus_notice_t01_handoff.md",
    "format:check": "prettier --check app src shared fixtures tests package.json app.json playwright.config.ts tsconfig.json README.md docs/campus_notice_c_startup_plan.md docs/campus_notice_t01_handoff.md",
    "check": "npm run typecheck && npm test && npm run format:check",
    "test:e2e": "npm run build:web && playwright test"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "expo": "58.0.25",
    "expo-constants": "58.0.16",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.31",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
